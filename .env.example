# Copy this file to .env.production and replace every placeholder.
# Docker Compose reads this file with: docker compose --env-file .env.production ...
DB_NAME=educhain_lms
DB_USER=educhain
DB_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Bind the HTTP services to loopback; terminate HTTPS in a reverse proxy.
STUDENT_HTTP_PORT=8080
ADMIN_HTTP_PORT=8081

# These values are public and are embedded in both browser bundles at build time.
VITE_GANACHE_CHAIN_ID=11155111
VITE_GANACHE_RPC_URL=https://your-public-rpc.example
VITE_GANACHE_CURRENCY_SYMBOL=ETH
VITE_CHAIN_NAME=Sepolia
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Server-side verification must use the same chain and contract.
CHAIN_RPC_URL=https://your-server-rpc.example
CHAIN_ID=11155111
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_CONFIRMATIONS=1

# Optional: comma-separated browser origins for cross-origin API use.
# Same-origin requests through the included Nginx proxy do not need this.
CORS_ORIGINS=
